<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:spacing="8dp"
        android:layout_marginBottom="8dp">

        <Spinner
            android:id="@+id/scriptTemplate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:entries="@array/script_templates" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scriptRun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶ Run" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scriptClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scriptSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:hint="Internal automation script…">

        <EditText
            android:id="@+id/scriptEditor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="10"
            android:fontFamily="monospace"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Command reference"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:spacing="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="`click &quot;Calculator&quot;` — tap element containing &quot;Calculator&quot;"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="`type &quot;hello&quot;` — type into focused field"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="`wait 1000` — pause ms"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="`repeat 3 { … }` — repeat block"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="`if found &quot;8&quot; { … }` — run if text on screen"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="`notify &quot;Done&quot;` — toast notification"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="`press back|home|recent` — navigation key"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="`// comment` — line comment"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:typeface="monospace" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/scriptOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/automa_background"
        android:padding="10dp"
        android:textColor="#22C55E"
        android:textSize="12sp"
        android:typeface="monospace"
        android:maxLines="6" />
</LinearLayout>
