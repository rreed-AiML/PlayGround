<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Custom Keyboard"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="On-screen keyboard with microphone (voice) input. Set as default IME to use in any app."
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/automa_surface"
        android:orientation="vertical"
        android:padding="14dp"
        android:spacing="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keyboard preview"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <FrameLayout
            android:id="@+id/kbPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@color/automa_background"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:spacing="8dp"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/kbToggleMic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mic: off" />

            <com.google.android.material.chip.Chip
                android:id="@+id/kbChipIme"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set as default IME" />
        </LinearLayout>

        <Spinner
            android:id="@+id/kbLayoutSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:entries="@array/kb_layouts" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mic uses SpeechRecognizer (Android) / Web Speech API (web demo)."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
